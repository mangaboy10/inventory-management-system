@page "/issue"
@rendermode InteractiveServer 
@using InventoryManagementSystem.Models
@using InventoryManagementSystem.Service
@inject ItemService ItemService
@inject StaffService StaffService
@inject TransactionService TransactionService
@inject NavigationManager Nav

<h3>Issue Items</h3>

<EditForm Model="@transaction" OnValidSubmit="SaveIssue">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Item</label>
        <InputSelect class="form-control" @bind-Value="transaction.Item_ID">
            <option value="0">Select Item</option>
            @foreach (var item in items)
            {
                <option value="@item.Item_ID">@item.Item_Name</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Staff</label>
        <InputSelect class="form-control" @bind-Value="transaction.Staff_ID">
            <option value="">Select Staff</option>
            @foreach (var staff in staffMembers)
            {
                <option value="@staff.Staff_ID">@staff.Staff_Name</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Quantity</label>
        <InputNumber class="form-control" @bind-Value="transaction.Qty" />
    </div>

    <div class="mb-3">
        <label class="form-label">Transaction Date</label>
        <InputDate class="form-control" @bind-Value="transaction.Transaction_Date" />
    </div>

    <div class="mb-3">
        <label class="form-label">Remarks</label>
        <InputText class="form-control" @bind-Value="transaction.Remarks" />
    </div>

    <button type="submit" class="btn btn-primary me-2">Save</button>
    <button type="button" class="btn btn-secondary" @onclick="GoBack">Cancel</button>
</EditForm>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private ItemTransaction transaction = new();
    private List<Item> items = new();
    private List<Staff> staffMembers = new();
    private string message = "";

    protected override async Task OnInitializedAsync()
    {
        items = await ItemService.GetAllItemsAsync();
        staffMembers = await StaffService.GetAllStaffAsync();

        transaction.Transaction_Type = "I";
        transaction.Transaction_Date = DateTime.Today;
    }

    private async Task SaveIssue()
    {
        var result = await TransactionService.AddTransactionAsync(transaction);

        message = result.Message;

        if (result.Success)
        {
            Nav.NavigateTo("/transactions");
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/transactions");
    }
}